                  "Property": "run_id"
                }
              },
              "queryRef": "dim_run.run_id",
              "nativeQueryRef": "run_id",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_run"
                    }
                  },
                  "Property": "market_type"
                }
              },
              "queryRef": "dim_run.market_type",
              "nativeQueryRef": "market_type"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_run"
                    }
                  },
                  "Property": "Avg IC"
                }
              },
              "queryRef": "dim_run.Avg IC",
              "nativeQueryRef": "Avg IC"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_run"
                    }
                  },
                  "Property": "Total Return %"
                }
              },
              "queryRef": "dim_run.Total Return %",
              "nativeQueryRef": "Total Return %"
            }
          ]
