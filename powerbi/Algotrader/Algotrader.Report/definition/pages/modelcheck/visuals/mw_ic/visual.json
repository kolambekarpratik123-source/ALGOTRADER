{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "mw_ic",
  "position": {
    "x": 20,
    "y": 85,
    "z": 10,
    "height": 300,
    "width": 400,
    "tabOrder": 10
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_run"
                    }
                  },
                  "Property": "market_type"
                }
              },
              "queryRef": "dim_run.market_type",
              "nativeQueryRef": "market_type",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_run"
                    }
                  },
                  "Property": "Avg IC"
                }
              },
              "queryRef": "dim_run.Avg IC",
              "nativeQueryRef": "Avg IC"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Prediction accuracy (IC). Noise should be ~0'"
                }
              }
            }
          }
        }
      ]
    }
  }
}