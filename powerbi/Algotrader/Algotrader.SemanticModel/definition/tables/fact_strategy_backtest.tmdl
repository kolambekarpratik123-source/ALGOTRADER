	partition fact_strategy_backtest = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_strategy_backtest.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"data_source", type text}, {"strategy", type text}, {"symbol", type text}, {"period_start", type text}, {"period_end", type text}, {"total_return_pct", type number}, {"buy_hold_return_pct", type number}, {"trade_count", Int64.Type}, {"win_rate_pct", type number}, {"max_drawdown_pct", type number}, {"sharpe", type number}, {"total_costs", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
