	partition dim_stock = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_stock.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"symbol", type text}, {"company_name", type text}, {"sector", type text}, {"data_source", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
