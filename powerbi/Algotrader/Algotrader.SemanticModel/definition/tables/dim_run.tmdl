table dim_run
	lineageTag: af9862b7-2d14-53a9-8a3f-78329aae59e8

	/// Ranker return over the test period, after costs
	measure 'Total Return %' =
			AVERAGE ( dim_run[total_return_pct] ) / 100
		formatString: 0.0%
		lineageTag: 225fa44e-24d5-5d47-ac13-94a0a4da0e20

	/// Return from holding every stock equally
	measure 'Benchmark Return %' =
			AVERAGE ( dim_run[benchmark_return_pct] ) / 100
		formatString: 0.0%
		lineageTag: c813de4a-70e9-5d7d-b9cb-bc0b8c829559

	/// Ranker minus benchmark
	measure 'Excess Return %' =
			[Total Return %] - [Benchmark Return %]
		formatString: 0.0%
		lineageTag: 5eb0fc1e-f5ed-5a0f-b9a8-372881711d48

	/// Largest fall from a peak
	measure 'Max Drawdown %' =
			-MAX ( dim_run[max_drawdown_pct] ) / 100
		formatString: 0.0%
		lineageTag: 8f1bd47f-9fae-58aa-bcaf-0b28ce165fae

	/// Worst calendar month
	measure 'Worst Month %' =
			MIN ( dim_run[worst_month_pct] ) / 100
		formatString: 0.0%
		lineageTag: b0990e7d-4683-53d8-95b5-a03e2d737a9e

	/// Prediction accuracy: rank correlation of score vs actual return. 0 = no skill
	measure 'Avg IC' =
			AVERAGE ( dim_run[ic] )
		formatString: 0.000
		lineageTag: c9ec6425-90a4-5859-a3a5-f58e75eef773

	/// Number of runs where the ranker beat holding everything
	measure 'Runs Beating Benchmark' =
			COUNTROWS ( FILTER ( dim_run, dim_run[total_return_pct] > dim_run[benchmark_return_pct] ) )
		formatString: 0
		lineageTag: 5a2a9255-d0e8-54cd-af20-71fbff494743

	measure 'Starting Capital' =
			MAX ( dim_run[initial_capital] )
		formatString: #,0
		lineageTag: 8a53bbc1-f99c-5568-abca-5d8165c8209e

