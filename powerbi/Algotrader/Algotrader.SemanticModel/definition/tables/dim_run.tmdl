	partition dim_run = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_run.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"run_id", Int64.Type}, {"created_at", type text}, {"data_source", type text}, {"market_type", type text}, {"seed", Int64.Type}, {"signal_strength", type number}, {"is_showcase", Int64.Type}, {"top_k", Int64.Type}, {"rebalance_days", Int64.Type}, {"horizon_days", Int64.Type}, {"initial_capital", type number}, {"ic", type number}, {"ic_tstat", type number}, {"total_return_pct", type number}, {"benchmark_return_pct", type number}, {"cagr_pct", type number}, {"max_drawdown_pct", type number}, {"sharpe", type number}, {"worst_month_pct", type number}, {"total_costs", type number}, {"trade_count", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
